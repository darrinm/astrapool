{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pool",
  "account_id": "f1a4a152b72d6ebcb0b82a8b384d4c1b",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "astrapool.darrinm.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "main": "server/worker.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "POOL_ROOMS",
        "class_name": "PoolRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PoolRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "d1_databases": [
    {
      "binding": "GAME_ANALYTICS",
      "database_name": "astrapool-analytics",
      "database_id": "4c86756c-d7a0-4309-888c-026a5156ec08",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMIT",
      "namespace_id": "1087",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
