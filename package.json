{
  "name": "astrapool",
  "version": "1.0.0",
  "description": "A 7-foot pool table you can walk around, in the browser: real physics, house-rules 8-ball, three computer opponents, private online rooms, and a solar system you can rack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test physics/*.test.mjs src/*.test.mjs server/protocol.test.mjs tools/*.test.mjs",
    "benchmark:computer": "node physics/benchmark-computer.mjs",
    "physics-test": "node physics/validate.mjs",
    "deploy": "npm run heads:guard && npm run build && wrangler deploy",
    "dev:online": "npm run build && wrangler dev --port 8787",
    "test:online": "node --test server/room.integration.mjs",
    "heads:status": "node tools/heads.mjs status",
    "heads:stash": "node tools/heads.mjs stash",
    "heads:restore": "node tools/heads.mjs restore",
    "heads:clear": "node tools/heads.mjs clear",
    "check:publishable": "node tools/check-publishable.mjs",
    "deploy:private": "npm run heads:restore && npm run build && wrangler deploy --config wrangler.private.jsonc",
    "heads:guard": "node tools/heads.mjs guard"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^8.2.2",
    "wrangler": "^4.129.0",
    "ws": "^8.21.3"
  },
  "license": "MIT",
  "homepage": "https://astrapool.darrinm.com"
}
