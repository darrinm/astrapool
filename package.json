{
  "name": "pool",
  "version": "1.0.0",
  "description": "A 7-foot pool table in three.js and Rapier, racked with the Playful Heads",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test physics/*.test.mjs server/protocol.test.mjs",
    "physics-test": "node physics/validate.mjs",
    "deploy": "npm run build && wrangler deploy",
    "dev:online": "npm run build && wrangler dev --port 8787",
    "test:online": "node --test server/room.integration.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^8.2.2",
    "wrangler": "^4.129.0",
    "ws": "^8.21.3"
  }
}
